# Guard-Deps Configuration Example
# Copy this file to .env and modify as needed

# Root directory to scan for Node.js projects (required)
PROJECTS_ROOT=/Users/your/project

# Comma-separated list of directories to ignore during scanning
IGNORE_DIRS=dist,build,.git,.next,coverage,.nyc_output,tmp,temp

# Advisory source - can be local file or remote URL
ADVISORY_SOURCE=file:./malicious-packages.txt

# Alternative remote advisory sources (examples):
# ADVISORY_SOURCE=https://raw.githubusercontent.com/security-advisories/npm/main/advisories.json
# ADVISORY_SOURCE=https://api.socket.dev/v0/advisories