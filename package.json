{
  "name": "guard-deps",
  "version": "0.1.0",
  "description": "NPM Dependency Security Scanner - Detect compromised packages and suggest fixes",
  "main": "dist/cli.js",
  "bin": {
    "guard-deps": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "npm",
    "dependencies",
    "scanner",
    "supply-chain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "semver": "^7.5.4",
    "fast-glob": "^3.3.1",
    "cli-table3": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/semver": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "malicious-packages.txt",
    "README.md",
    "CLAUDE.md"
  ],
  "overrides": {
    "is-core-module": "2.13.1",
    "picocolors": "1.0.0"
  }
}
